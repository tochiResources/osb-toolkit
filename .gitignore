node_modules/
dist/
dist-*/
.turbo/
target/
*.tsbuildinfo
.DS_Store
Thumbs.db
.vite/
coverage/

# Stray compiler artifacts (tracked by mistake historically)
*.obj
*.pdb

# Test render outputs
*-render.png

# Machine-specific mermaid-cli browsedriver config (generated on demand)
puppeteer-config.json

# Yarn install state (regenerated by `yarn install`)
.yarn/install-state.gz
.yarn/cache/


# Generated plug-in build output (never the source `packages/*/src/build` tree)
**/native/build/
/build/
/out/
*.aex
*.prm
*.plugin
*.ofx
*.ofx.bundle/

# vendor build tools
# Adobe After Effects: https://developer.adobe.com/after-effects/
# OpenFX: https://github.com/AcademySoftwareFoundation/openfx
vendor/

# Local env
.env
.env.*
!.env.example

# .NET build output (the Roslyn C# lint tool and the C# binding projects)
tools/**/bin/
tools/**/obj/
bindings/**/bin/
bindings/**/obj/
bindings/cpp/test/build/

# wasm-bindgen output (regenerated by `yarn build:wasm`)
packages/native/wasm/

# @deltabox/toolchain (generated state; keep only the manifests)
**/.dbx/*
!**/.dbx/toolchain
**/.dbx/toolchain/*
!**/.dbx/toolchain/manifest.json

# Python bytecode
__pycache__/
*.pyc
