{
    "name": "@tochii/osb-toolkit-shared",
    "version": "0.1.0",
    "description": "Shared types, errors, compatibility data and utilities for osbTK.",
    "type": "module",
    "license": "BSD-3-Clause",
    "author": "T0chi",
    "homepage": "https://osb-toolkit.tochi.moe",
    "repository": {
        "type": "git",
        "url": "https://github.com/tochiResources/osb-toolkit.git",
        "directory": "packages/shared"
    },
    "scripts": {
        "build": "tsdown --config-loader unrun",
        "test": "vitest run",
        "typecheck": "tsc -p tsconfig.build.json --noEmit"
    },
    "dependencies": {
        "@tochii/errors": "portal:../../../errors",
        "zod": "catalog:"
    },
    "devDependencies": {
        "@types/node": "catalog:",
        "tsdown": "catalog:",
        "tsx": "catalog:",
        "type-fest": "catalog:",
        "typescript": "catalog:",
        "vite": "catalog:",
        "vitest": "catalog:"
    },
    "publishConfig": {
        "access": "public"
    },
    "packageManager": "yarn@4.17.1",
    "engines": {
        "node": ">=22.5.0"
    },
    "files": [
        "dist"
    ],
    "types": "./dist/index.d.ts",
    "exports": {
        ".": "./dist/index.js",
        "./errors": "./dist/errors.js",
        "./errors/codes": "./dist/errors/codes.js",
        "./errors/base": "./dist/errors/base.js",
        "./errors/domains": "./dist/errors/domains.js",
        "./exec": "./dist/exec.js",
        "./logger": "./dist/logger.js",
        "./constants": "./dist/constants.js",
        "./targets": "./dist/targets.js",
        "./compat": "./dist/compat.js",
        "./ir": "./dist/ir.js",
        "./plugin-spec": "./dist/plugin-spec.js",
        "./fs": "./dist/fs.js",
        "./paths": "./dist/paths.js",
        "./slug": "./dist/slug.js",
        "./package.json": "./package.json"
    }
}
